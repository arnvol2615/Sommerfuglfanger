# Sommerfuglfanger Environment Configuration
# Copy this file to .env.local and fill in the values from your Supabase project

# Supabase Configuration (Required for backend integration)
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Configuration (for Supabase Edge Functions)
# - SUPABASE_SERVICE_ROLE_KEY: Set in Supabase Edge Functions → Secrets
# - INAT_API_TOKEN: Get from https://www.inaturalist.org/users/api_token, set as Edge Function secret
